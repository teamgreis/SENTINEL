<Window x:Class="Sentinel.App.AddUserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SENTINEL — Nutzer hinzufügen"
        Height="440" Width="420"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="36">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Nutzer hinzufügen" Style="{StaticResource Heading}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,18" TextWrapping="Wrap"
                       Text="Legt einen weiteren Sentinel-Nutzer an."/>

            <TextBlock Text="NAME" Style="{StaticResource Eyebrow}"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,12"/>

            <TextBlock Text="PASSWORT" Style="{StaticResource Eyebrow}"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,12"/>

            <TextBlock Text="PASSWORT WIEDERHOLEN" Style="{StaticResource Eyebrow}"/>
            <PasswordBox x:Name="ConfirmBox" Margin="0,0,0,12"/>

            <TextBlock Text="ROLLE" Style="{StaticResource Eyebrow}"/>
            <ComboBox x:Name="RoleBox" SelectedIndex="1" Margin="0,0,0,10">
                <ComboBoxItem Content="Administrator"/>
                <ComboBoxItem Content="Nutzer"/>
            </ComboBox>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Red}" FontSize="12"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Click="Cancel_Click" IsCancel="True"
                        Style="{StaticResource SecondaryButton}" Padding="16,8"/>
                <Button Content="Anlegen" Click="Ok_Click" IsDefault="True"
                        Padding="16,8" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
