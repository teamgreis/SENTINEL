<Window x:Class="Sentinel.App.AdminResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SENTINEL — Passwort zurücksetzen"
        Height="360" Width="400"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="36">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Passwort zurücksetzen" Style="{StaticResource Heading}"/>
            <TextBlock x:Name="Subtitle" Style="{StaticResource Muted}" Margin="0,4,0,18" TextWrapping="Wrap"/>

            <TextBlock Text="NEUES PASSWORT" Style="{StaticResource Eyebrow}"/>
            <PasswordBox x:Name="NewBox" Margin="0,0,0,12"/>

            <TextBlock Text="WIEDERHOLEN" Style="{StaticResource Eyebrow}"/>
            <PasswordBox x:Name="ConfirmBox" Margin="0,0,0,10"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Red}" FontSize="12"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Click="Cancel_Click" IsCancel="True"
                        Style="{StaticResource SecondaryButton}" Padding="16,8"/>
                <Button Content="Zurücksetzen" Click="Ok_Click" IsDefault="True"
                        Padding="16,8" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
