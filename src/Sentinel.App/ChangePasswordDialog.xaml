<Window x:Class="Sentinel.App.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SENTINEL — Passwort ändern"
        Height="400" Width="420"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="36">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Passwort ändern" Style="{StaticResource Heading}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,18"
                       Text="Das neue Passwort muss mindestens 8 Zeichen haben."/>

            <TextBlock Text="AKTUELLES PASSWORT" Style="{StaticResource Eyebrow}"/>
            <PasswordBox x:Name="CurrentBox" Margin="0,0,0,12"/>

            <TextBlock Text="NEUES PASSWORT" Style="{StaticResource Eyebrow}"/>
            <PasswordBox x:Name="NewBox" Margin="0,0,0,12"/>

            <TextBlock Text="NEUES PASSWORT WIEDERHOLEN" Style="{StaticResource Eyebrow}"/>
            <PasswordBox x:Name="ConfirmBox" Margin="0,0,0,10"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Red}" FontSize="12"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Click="Cancel_Click" IsCancel="True"
                        Style="{StaticResource SecondaryButton}" Padding="16,8"/>
                <Button Content="Ändern" Click="Change_Click" IsDefault="True"
                        Padding="16,8" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
