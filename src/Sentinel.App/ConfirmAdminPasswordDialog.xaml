<Window x:Class="Sentinel.App.ConfirmAdminPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SENTINEL — Bestätigung"
        Height="300" Width="400"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="36">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Administrator-Passwort" Style="{StaticResource Heading}"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,18" TextWrapping="Wrap"
                       Text="Diese Aktion erfordert die Bestätigung eines Administrators."/>

            <TextBlock Text="ADMIN-PASSWORT" Style="{StaticResource Eyebrow}"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,10" KeyDown="PasswordBox_KeyDown"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Red}" FontSize="12"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Click="Cancel_Click" IsCancel="True"
                        Style="{StaticResource SecondaryButton}" Padding="16,8"/>
                <Button Content="Bestätigen" Click="Ok_Click" IsDefault="True"
                        Padding="16,8" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
