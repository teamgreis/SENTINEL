<Window x:Class="Sentinel.App.InfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SENTINEL — Info" Height="620" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource FontUI}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="SENTINEL" FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource Text}"/>
            <TextBlock x:Name="VersionText" FontSize="13"
                       Foreground="{DynamicResource Cyan}"
                       FontFamily="{StaticResource FontMono}"/>
            <TextBlock x:Name="CreditText" FontSize="11"
                       Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Tabs -->
        <TabControl Grid.Row="2" Margin="0,16,0,0" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="bd" Padding="14,8" CornerRadius="6,6,0,0"
                                        Background="{DynamicResource Surface}">
                                    <ContentPresenter ContentSource="Header"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource SurfaceLight}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- Über -->
            <TabItem Header="Über">
                <Border Background="{DynamicResource Surface}" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock x:Name="DescText" TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource TextMuted}" Margin="0,0,0,14"/>

                            <TextBlock Text="KONZEPT" Style="{StaticResource Eyebrow}"/>
                            <ItemsControl x:Name="ConceptList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Margin="0,0,0,6" TextAlignment="Justify"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="GRENZEN — WAS SENTINEL NICHT KANN" Style="{StaticResource Eyebrow}"
                                       Margin="0,14,0,0"/>
                            <ItemsControl x:Name="LimitationsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Margin="0,0,0,6" TextAlignment="Justify"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Änderungsprotokoll -->
            <TabItem Header="Versionen">
                <Border Background="{DynamicResource Surface}" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ChangelogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceLight}" CornerRadius="8"
                                            Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Version}" FontWeight="Bold"
                                                           Foreground="{DynamicResource Text}" FontSize="13"/>
                                                <TextBlock Text="{Binding Date}" Foreground="{DynamicResource TextFaint}"
                                                           FontSize="11" Margin="8,0,0,0"/>
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Changes}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="• " Foreground="{DynamicResource TextMuted}"
                                                                   FontSize="11"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Lizenz -->
            <TabItem Header="Lizenz">
                <Border Background="{DynamicResource Surface}" Padding="16">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="LicenseText" IsReadOnly="True" BorderThickness="0"
                                 Background="Transparent" Foreground="{DynamicResource TextMuted}"
                                 FontFamily="{StaticResource FontMono}" FontSize="11"
                                 TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Fuß -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Handbuch öffnen" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0" Click="OpenManual_Click"/>
            <Button Content="Schließen" Width="100" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
