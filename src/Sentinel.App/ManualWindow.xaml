<Window x:Class="Sentinel.App.ManualWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SENTINEL — Handbuch" Height="640" Width="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource FontUI}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Kopf -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Handbuch" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="Schritt für Schritt — alles, was du für den Anfang wissen musst."
                       FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Kapitel -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ChapterList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Surface}" CornerRadius="10"
                                Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Text}"/>
                                <ItemsControl ItemsSource="{Binding Steps}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Margin="0,0,0,6" TextAlignment="Justify"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Fuß -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <TextBlock x:Name="FooterText" VerticalAlignment="Center" FontSize="10"
                       Foreground="{DynamicResource TextFaint}" Margin="0,0,12,0"/>
            <Button Content="Schließen" Width="100" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
