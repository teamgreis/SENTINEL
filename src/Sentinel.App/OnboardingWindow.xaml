<Window x:Class="Sentinel.App.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SENTINEL 2.5 Beta — Einrichtung"
        Height="700" Width="540"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Grid Margin="40">
        <StackPanel VerticalAlignment="Center">

            <!-- Branding -->
            <TextBlock Text="SENTINEL" HorizontalAlignment="Center"
                       FontSize="30" FontWeight="FontWeights.Light" Foreground="White"/>
            <TextBlock Text="2.5 Beta" HorizontalAlignment="Center" FontSize="12"
                       Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
            <TextBlock Text="© Felix Greis (Alias: Elian)" HorizontalAlignment="Center" FontSize="10"
                       Foreground="{StaticResource TextFaint}" Margin="0,3,0,24"/>

            <!-- Schritt 1: Konto -->
            <TextBlock Text="Schritt 1 — Administratorkonto" Style="{StaticResource Heading}" FontSize="16"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,16" TextWrapping="Wrap"
                       Text="Das erste Konto ist automatisch Administrator. Es schützt deine lokalen Daten und die App selbst – es verlässt nie deinen PC."/>

            <TextBlock Text="ANZEIGENAME" Style="{StaticResource Eyebrow}"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,14"/>

            <TextBlock Text="PASSWORT" Style="{StaticResource Eyebrow}"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,6"
                         PasswordChanged="PasswordBox_PasswordChanged"/>
            <TextBlock x:Name="StrengthBar" Style="{StaticResource Muted}" FontSize="11"
                       Margin="0,0,0,14"/>

            <TextBlock Text="PASSWORT WIEDERHOLEN" Style="{StaticResource Eyebrow}"/>
            <PasswordBox x:Name="PasswordConfirmBox" Margin="0,0,0,6"/>

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource Red}"
                       FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"
                       Visibility="Collapsed"/>

            <Button x:Name="CreateButton" Content="Konto erstellen und Backup-Codes anzeigen" Click="Create_Click"
                    Padding="20,12" FontSize="14" Margin="0,10,0,0"/>

            <!-- Schritt 2: Backup-Codes -->
            <Border x:Name="BackupPanel" Style="{StaticResource Card}" Margin="0,18,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Schritt 2 — Backup-Codes" Style="{StaticResource Heading}" FontSize="16"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12" TextWrapping="Wrap"
                               Text="Diese zwei Codes sind deine Rettung, falls du das Passwort vergisst. Notiere sie jetzt – danach werden sie nicht mehr angezeigt. Jeder Code gilt nur EINMAL."/>

                    <TextBlock x:Name="BackupKey1Text" FontFamily="{StaticResource FontMono}" FontSize="20"
                               Foreground="{StaticResource Cyan}" HorizontalAlignment="Center"
                               Padding="10,6"/>
                    <TextBlock x:Name="BackupKey2Text" FontFamily="{StaticResource FontMono}" FontSize="20"
                               Foreground="{StaticResource Cyan}" HorizontalAlignment="Center"
                               Padding="10,6" Margin="0,6,0,0"/>

                    <TextBlock Style="{StaticResource Muted}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"
                               Foreground="{StaticResource Amber}"
                               Text="⚠ Drucke sie aus oder notiere sie an einem sicheren Ort. Nach dem Schließen dieses Fensters sind sie nur noch als Hash gespeichert."/>

                    <Button Content="Fertig — SENTINEL starten" Click="Finish_Click"
                            Padding="20,12" FontSize="14" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </Grid>
</Window>
