<!-- SENTINEL Designsystem v3 -->
<!-- Farb-Tokens kommen aus Themes/Theme.<Name>.xaml (5 Designs, zur Laufzeit tauschbar). -->
<!-- Styles und Typografie stehen hier und verweisen per StaticResource auf die Tokens. -->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===== Brushes (aus den Token-Colors des aktiven Designs) ===== -->
    <SolidColorBrush x:Key="Bg" Color="{DynamicResource BgColor}"/>
    <SolidColorBrush x:Key="Surface" Color="{DynamicResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceHover" Color="{DynamicResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="SurfaceLight" Color="{DynamicResource SurfaceLightColor}"/>
    <SolidColorBrush x:Key="Border" Color="{DynamicResource BorderColor}"/>
    <SolidColorBrush x:Key="Violet" Color="{DynamicResource VioletColor}"/>
    <SolidColorBrush x:Key="NeonViolet" Color="{DynamicResource NeonVioletColor}"/>
    <SolidColorBrush x:Key="Cyan" Color="{DynamicResource CyanColor}"/>
    <SolidColorBrush x:Key="Green" Color="{DynamicResource GreenColor}"/>
    <SolidColorBrush x:Key="Amber" Color="{DynamicResource AmberColor}"/>
    <SolidColorBrush x:Key="Red" Color="{DynamicResource RedColor}"/>
    <SolidColorBrush x:Key="Text" Color="{DynamicResource TextColor}"/>
    <SolidColorBrush x:Key="TextMuted" Color="{DynamicResource TextMutedColor}"/>
    <SolidColorBrush x:Key="TextFaint" Color="{DynamicResource TextFaintColor}"/>
    <SolidColorBrush x:Key="NavActive" Color="{DynamicResource NavActiveColor}"/>

    <!-- ===== Typografie ===== -->
    <FontFamily x:Key="FontUI">Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas</FontFamily>

    <sys:Double x:Key="TextXS">11</sys:Double>
    <sys:Double x:Key="TextS">12</sys:Double>
    <sys:Double x:Key="TextM">13</sys:Double>
    <sys:Double x:Key="TextL">15</sys:Double>
    <sys:Double x:Key="TextXL">18</sys:Double>
    <sys:Double x:Key="TextDisplay">30</sys:Double>

    <!-- ===== Abstände / Radien ===== -->
    <sys:Double x:Key="RadiusS">6</sys:Double>
    <sys:Double x:Key="RadiusM">10</sys:Double>
    <sys:Double x:Key="RadiusL">14</sys:Double>

    <!-- ===== Basis-Stile ===== -->

    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
        <Setter Property="FontSize" Value="{StaticResource TextM}"/>
    </Style>

    <Style x:Key="Display" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource TextDisplay}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="Heading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="FontSize" Value="{StaticResource TextXL}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style x:Key="Muted" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="{StaticResource TextS}"/>
    </Style>

    <Style x:Key="Eyebrow" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{StaticResource Cyan}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
        <Setter Property="FontSize" Value="{StaticResource TextXS}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- ===== Buttons ===== -->

    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Violet}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
        <Setter Property="FontSize" Value="{StaticResource TextM}"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource NeonViolet}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#7C3AED"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceLight}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Violet}" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Border}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#7F1D1D"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#991B1B"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Navigation ===== -->

    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
        <Setter Property="FontSize" Value="{StaticResource TextM}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="4,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="14,10">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource NavActive}"/>
                            <Setter Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Eingaben ===== -->

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource SurfaceLight}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Cyan}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource Violet}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
        <Setter Property="FontSize" Value="{StaticResource TextM}"/>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{StaticResource SurfaceLight}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Cyan}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
        <Setter Property="FontSize" Value="{StaticResource TextM}"/>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="FontFamily" Value="{StaticResource FontUI}"/>
        <Setter Property="FontSize" Value="{StaticResource TextM}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource SurfaceLight}"/>
        <Setter Property="Foreground" Value="{StaticResource Text}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="Padding" Value="8,5"/>
    </Style>

    <!-- ===== Container ===== -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>

    <Style x:Key="CardHover" TargetType="Border" BasedOn="{StaticResource Card}"/>

    <!-- ===== ScrollBar (dezent) ===== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
    </Style>

    <!-- ===== Toggle-Switch (als CheckBox-Template) ===== -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="track" Width="40" Height="22" CornerRadius="11"
                                Background="{StaticResource SurfaceLight}"
                                BorderBrush="{StaticResource Border}" BorderThickness="1">
                            <Ellipse x:Name="thumb" Width="14" Height="14"
                                     Fill="{StaticResource TextMuted}"
                                     HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{TemplateBinding Content}"
                                   Foreground="{StaticResource Text}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background" Value="{StaticResource Violet}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Violet}"/>
                            <Setter TargetName="thumb" Property="Fill" Value="White"/>
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="thumb" Property="Margin" Value="0,0,4,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
