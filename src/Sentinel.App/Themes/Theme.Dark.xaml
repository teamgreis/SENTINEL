<!-- Design: Sentinel Dark (Standard) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Color x:Key="BgColor">#0A0912</Color>
    <Color x:Key="SurfaceColor">#13111F</Color>
    <Color x:Key="SurfaceHoverColor">#1C1929</Color>
    <Color x:Key="SurfaceLightColor">#242135</Color>
    <Color x:Key="BorderColor">#2E2A44</Color>
    <Color x:Key="VioletColor">#8B5CF6</Color>
    <Color x:Key="NeonVioletColor">#A855F7</Color>
    <Color x:Key="CyanColor">#22D3EE</Color>
    <Color x:Key="GreenColor">#4ADE80</Color>
    <Color x:Key="AmberColor">#FBBF24</Color>
    <Color x:Key="RedColor">#F87171</Color>
    <Color x:Key="TextColor">#E7E5F0</Color>
    <Color x:Key="TextMutedColor">#8B87A0</Color>
    <Color x:Key="TextFaintColor">#5C5872</Color>
    <Color x:Key="NavActiveColor">#221E33</Color>

</ResourceDictionary>
