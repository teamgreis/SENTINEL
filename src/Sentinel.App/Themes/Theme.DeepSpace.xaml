<!-- Design: DeepSpace — schwarz mit Neon-Grün -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Color x:Key="BgColor">#000000</Color>
    <Color x:Key="SurfaceColor">#0A0F0A</Color>
    <Color x:Key="SurfaceHoverColor">#121A12</Color>
    <Color x:Key="SurfaceLightColor">#1A261A</Color>
    <Color x:Key="BorderColor">#1F331F</Color>
    <Color x:Key="VioletColor">#22C55E</Color>
    <Color x:Key="NeonVioletColor">#4ADE80</Color>
    <Color x:Key="CyanColor">#A3E635</Color>
    <Color x:Key="GreenColor">#4ADE80</Color>
    <Color x:Key="AmberColor">#FACC15</Color>
    <Color x:Key="RedColor">#F87171</Color>
    <Color x:Key="TextColor">#D1FADF</Color>
    <Color x:Key="TextMutedColor">#6B8F70</Color>
    <Color x:Key="TextFaintColor">#3D5540</Color>
    <Color x:Key="NavActiveColor">#122012</Color>

</ResourceDictionary>
