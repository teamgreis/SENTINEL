<!-- Design: Midnight — tiefes Nachtblau -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Color x:Key="BgColor">#050D1F</Color>
    <Color x:Key="SurfaceColor">#0C1832</Color>
    <Color x:Key="SurfaceHoverColor">#132244</Color>
    <Color x:Key="SurfaceLightColor">#1B2D5A</Color>
    <Color x:Key="BorderColor">#25406E</Color>
    <Color x:Key="VioletColor">#3B82F6</Color>
    <Color x:Key="NeonVioletColor">#60A5FA</Color>
    <Color x:Key="CyanColor">#38BDF8</Color>
    <Color x:Key="GreenColor">#34D399</Color>
    <Color x:Key="AmberColor">#FBBF24</Color>
    <Color x:Key="RedColor">#F87171</Color>
    <Color x:Key="TextColor">#DDE9FF</Color>
    <Color x:Key="TextMutedColor">#7C93C4</Color>
    <Color x:Key="TextFaintColor">#4A5D8A</Color>
    <Color x:Key="NavActiveColor">#16294D</Color>

</ResourceDictionary>
