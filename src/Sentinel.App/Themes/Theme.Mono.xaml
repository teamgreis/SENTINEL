<!-- Design: Mono — reines Schwarz/Weiß, maximaler Kontrast, farbfrei (barrierefrei) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Color x:Key="BgColor">#000000</Color>
    <Color x:Key="SurfaceColor">#0D0D0D</Color>
    <Color x:Key="SurfaceHoverColor">#1A1A1A</Color>
    <Color x:Key="SurfaceLightColor">#262626</Color>
    <Color x:Key="BorderColor">#3D3D3D</Color>
    <Color x:Key="VioletColor">#FFFFFF</Color>
    <Color x:Key="NeonVioletColor">#E0E0E0</Color>
    <Color x:Key="CyanColor">#BFBFBF</Color>
    <Color x:Key="GreenColor">#D9D9D9</Color>
    <Color x:Key="AmberColor">#BFBFBF</Color>
    <Color x:Key="RedColor">#FFFFFF</Color>
    <Color x:Key="TextColor">#FFFFFF</Color>
    <Color x:Key="TextMutedColor">#A6A6A6</Color>
    <Color x:Key="TextFaintColor">#737373</Color>
    <Color x:Key="NavActiveColor">#1F1F1F</Color>

</ResourceDictionary>
